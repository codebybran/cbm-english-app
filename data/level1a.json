    { "id": 24, "cat": 4, "text": "...but right now...", "linked": "/ba-rai-nau/", "rule": "'T' finales de 'but' y 'right' caen." },
    { "id": 25, "cat": 4, "text": "...and then...", "linked": "/an-den/", "rule": "'D' de and desaparece." },
    { "id": 26, "cat": 4, "text": "...with me", "linked": "/ui-mii/", "rule": "'Th' se desliza directo a la 'm'." },
