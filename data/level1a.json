  "dialogues": [
    {
      "title": "¿Nos vamos?",
      "lines": [
        { "who": "A", "text": "Do you want to go now?", "blocks": [6, 7] },
        { "who": "B", "text": "I am not ready, but right now I need to wait here.", "blocks": [18, 24, 2, 15] },
        { "who": "A", "text": "It is okay. I think that I have to wait with you.", "blocks": [30, 29, 3, 15, 27] },
        { "who": "B", "text": "I am ready. I want to go with you for today.", "blocks": [17, 1, 7, 27, 28] }
      ]
    },
    {
      "title": "Algo para comer",
      "lines": [
        { "who": "A", "text": "Do you want to eat something?", "blocks": [6, 9] },
        { "who": "B", "text": "I don't want to eat this. I want to buy this.", "blocks": [4, 9, 10, 1, 12] },
        { "who": "A", "text": "Is it possible? Where is this?", "blocks": [22, 21] },
        { "who": "B", "text": "It is not here, because I need to see that.", "blocks": [20, 23, 2, 13] }
      ]
    },
    {
      "title": "Necesito ayuda",
      "lines": [
        { "who": "A", "text": "I don't understand this. Do you want to help me?", "blocks": [4, 16, 6, 14] },
        { "who": "B", "text": "It is okay. I want to speak with you and then help you.", "blocks": [30, 1, 11, 25, 14] },
        { "who": "A", "text": "I need to know more. I think that I am ready.", "blocks": [2, 8, 29, 17] },
        { "who": "B", "text": "I have to go now, but right now it is okay.", "blocks": [3, 7, 24, 30] }
      ]
    }
  ]
