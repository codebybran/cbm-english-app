    { "id": 6, "cat": 1, "text": "Do you want to...?", "linked": "/du-iu-uona/", "rule": "Do you se contrae a /diu/." },

    { "id": 7, "cat": 2, "text": "...go now", "linked": "/gou-nau/", "rule": "Flujo vocal continuo." },
    { "id": 8, "cat": 2, "text": "...know more", "linked": "/nou-mor/", "rule": "W es muda, se une /nou/ a /mor/." },
    { "id": 9, "cat": 2, "text": "...eat something", "linked": "/ii-tsom-zing/", "rule": "'T' de eat ataca la 's' de something." },
    { "id": 10, "cat": 2, "text": "...do this", "linked": "/du-diz/", "rule": "'Th' suena a 'd' vibrada." },
    { "id": 11, "cat": 2, "text": "...speak with you", "linked": "/spiik-ui-diu/", "rule": "'Th' de with con 'you' forma /diu/." },
    { "id": 12, "cat": 2, "text": "...buy this", "linked": "/bai-diz/", "rule": "Conexión directa sin pausar." },
    { "id": 13, "cat": 2, "text": "...see that", "linked": "/sii-dat/", "rule": "Vocal 'ee' se alarga a la 'd' de that." },
    { "id": 14, "cat": 2, "text": "...help me", "linked": "/jel-mii/", "rule": "'P' de help se ahoga antes de la 'm'." },
    { "id": 15, "cat": 2, "text": "...wait here", "linked": "/uei-tiar/", "rule": "'T' de wait se conecta con 'here'." },
    { "id": 16, "cat": 2, "text": "...understand this", "linked": "/an-der-stan-diz/", "rule": "'D' de understand une a 'th' de this." },

    { "id": 17, "cat": 3, "text": "I am ready", "linked": "/aim-redi/", "rule": "Contracción fluida de I am." },
    { "id": 18, "cat": 3, "text": "I am not ready", "linked": "/aim-no-tredi/", "rule": "'T' de not entra a la 'r' de ready." },
    { "id": 19, "cat": 3, "text": "It is here", "linked": "/i-tiz-jiar/", "rule": "'T' de It suena a 'r' suave latina con 'is'." },
    { "id": 20, "cat": 3, "text": "It is not here", "linked": "/i-tiz-no-tiar/", "rule": "'T' de not se arrastra a 'here'." },
    { "id": 21, "cat": 3, "text": "Where is...?", "linked": "/ue-riz/", "rule": "'R' de Where se pega a 'is'." },
    { "id": 22, "cat": 3, "text": "Is it possible?", "linked": "/i-zit-posibl/", "rule": "'S' de Is se pega a 'it'." },

